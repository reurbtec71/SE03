# Painel do Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Senha única de acesso ao sistema (equivalente à do sistema de Jequié)
ACCESS_PASSWORD=escolha-uma-senha-forte

# Usado para assinar o cookie de sessão — qualquer string longa e aleatória
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
